# Copy to terraform.tfvars and fill in before running terraform apply.
# Never commit terraform.tfvars - it is excluded by .gitignore.

subscription_id            = "00000000-0000-0000-0000-000000000000"
tenant_id                  = "00000000-0000-0000-0000-000000000000"
subnet_id                  = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example/providers/Microsoft.Network/virtualNetworks/vnet-example/subnets/snet-pe"
private_dns_zone_id        = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example/providers/Microsoft.Network/privateDnsZones/privatelink.vaultcore.azure.net"

# Use 7 (the minimum) for non-production environments so the vault name is available
# again quickly after a terraform destroy.
soft_delete_retention_days = 7
